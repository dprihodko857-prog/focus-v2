# Focus server environment example.
# This file is safe to commit and must not contain real credentials.
# Store real values only in the deployment secrets vault or a server-only .env file.

# Greeting Assistant AI provider
# Development/default mode uses MockGreetingAIProvider and performs no live API calls.
FOCUS_GREETING_AI_PROVIDER=mock

# Production Polza.ai activation, server only. Keep commented until approved.
# FOCUS_GREETING_AI_PROVIDER=polza
# FOCUS_POLZA_MODEL_COMPARISON_EVALUATION_ENABLED=false
# FOCUS_POLZA_PRODUCTION_ENABLED=false
# FOCUS_POLZA_MODEL_COMPARISON_APPROVED=false
# FOCUS_POLZA_API_KEY=
# FOCUS_POLZA_MODEL=
# FOCUS_POLZA_BASE_URL=https://polza.ai/api/v1
# FOCUS_POLZA_TIMEOUT_MS=30000
# FOCUS_POLZA_RETRY_ATTEMPTS=2
# FOCUS_POLZA_RATE_LIMIT_PER_MINUTE=30

# Legacy/comparison GigaChat adapter, not the selected production direction.
# FOCUS_GREETING_AI_PROVIDER=gigachat
# FOCUS_GIGACHAT_AUTHORIZATION_KEY=
# FOCUS_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# FOCUS_GIGACHAT_MODEL=
# FOCUS_GIGACHAT_BASE_URL=https://api.giga.chat
# FOCUS_GIGACHAT_TIMEOUT_MS=30000
# FOCUS_GIGACHAT_RETRY_ATTEMPTS=2
# FOCUS_GIGACHAT_RATE_LIMIT_PER_MINUTE=30
