[Unit]
Description=Focus v2 sync API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/focus-v2
Environment=NODE_ENV=production
Environment=FOCUS_SYNC_PORT=4178
Environment=FOCUS_SYNC_DB=/opt/focus-v2/data/focus-sync.json
Environment=FOCUS_PUSH_INTERVAL_MS=30000
EnvironmentFile=-/opt/focus-v2/data/focus-v2.env
ExecStart=/usr/bin/node /opt/focus-v2/server/sync-server.mjs
Restart=always
RestartSec=3
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/focus-v2/data

[Install]
WantedBy=multi-user.target
